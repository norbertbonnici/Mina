<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mina.ControlPlane.Pki\Mina.ControlPlane.Pki.csproj" />
  </ItemGroup>

  <!-- Azure.Identity 1.21+ rather than the 1.17.2 the egress sidecar pins: the Key Vault packages
       pull Azure.Core 1.54, which now carries DefaultAzureCredential itself, and the older
       Azure.Identity defines the same type again — the two together do not compile. -->
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" Version="4.10.1" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
  </ItemGroup>

</Project>
