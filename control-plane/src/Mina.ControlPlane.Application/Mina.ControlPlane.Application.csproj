<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mina.ControlPlane.Domain\Mina.ControlPlane.Domain.csproj" />
    <ProjectReference Include="..\Mina.ControlPlane.Pki\Mina.ControlPlane.Pki.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <!-- Binds and validates options here rather than in each host, so the API and the
         management UI cannot disagree about what a valid security policy is. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
