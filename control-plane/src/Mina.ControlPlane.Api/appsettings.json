{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "REPLACE_WITH_TENANT_ID",
    "ClientId": "REPLACE_WITH_APP_CLIENT_ID",
    "Audience": "REPLACE_WITH_APP_CLIENT_ID"
  },
  "Mina": {
    "Session": {
      "AnalystRole": "Mina.Analyst",
      "LeaseTtl": "01:00:00"
    },
    "Regions": {
      "Approved": [ "westeurope", "northeurope", "germanywestcentral", "francecentral" ],
      "Active": [ "westeurope" ]
    },
    "Egress": {
      "Regions": {
        "westeurope": {
          "Host": "REPLACE_WITH_WESTEUROPE_INGRESS_IP",
          "Port": 443,
          "ServerName": "westeurope.egress.mina.internal"
        }
      }
    }
  }
}
