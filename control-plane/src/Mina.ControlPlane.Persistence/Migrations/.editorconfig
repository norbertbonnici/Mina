# EF Core writes the files in this folder; they are regenerated by `dotnet ef migrations add` and
# must not be hand-edited, so analyzer style/performance rules are relaxed here only. Rules that
# could indicate a real defect stay on. Everywhere else in the repo, warnings remain errors.
[*.cs]
dotnet_diagnostic.CA1861.severity = none   # constant array arguments in generated CreateIndex calls
dotnet_diagnostic.CA1062.severity = none   # generated code does not null-check its parameters
dotnet_diagnostic.IDE0300.severity = none  # collection-expression preference
