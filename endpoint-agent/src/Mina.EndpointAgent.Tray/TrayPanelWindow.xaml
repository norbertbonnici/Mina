<Window x:Class="Mina.EndpointAgent.Tray.TrayPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mina research egress"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Panel}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>

            <!-- header -->
            <Grid Background="{StaticResource Panel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Mina research egress"
                           Margin="14,10,0,10"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Text}" />
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Content="&#x2715;"
                        Style="{StaticResource PanelButton}"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{StaticResource Muted}"
                        Margin="0,6,8,6"
                        Padding="8,2,8,2"
                        ToolTip="Close this panel. Your research session is not affected." />
            </Grid>

            <Border Height="1" Background="{StaticResource Line}" />

            <!-- state -->
            <StackPanel Margin="14,12,14,12">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StateDot" Width="9" Height="9" Margin="0,0,8,0"
                             VerticalAlignment="Center" Fill="{StaticResource Muted}" />
                    <TextBlock x:Name="Headline" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" />
                </StackPanel>
                <TextBlock x:Name="Detail"
                           Margin="0,6,0,0"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}" />
            </StackPanel>

            <!-- the fail-closed message; only present when browsing has stopped -->
            <Border x:Name="AlertBox"
                    Visibility="Collapsed"
                    Margin="14,0,14,12"
                    Padding="10,8,10,8"
                    CornerRadius="4"
                    Background="#1A1E24"
                    BorderBrush="{StaticResource Bad}"
                    BorderThickness="3,1,1,1">
                <TextBlock x:Name="AlertText"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Text}" />
            </Border>

            <Border Height="1" Background="{StaticResource Line}" />

            <!-- region -->
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Egress region" Style="{StaticResource Label}" />
                <ComboBox x:Name="RegionBox"
                          Grid.Column="1"
                          HorizontalAlignment="Right"
                          MinWidth="200"
                          FontSize="12"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Name" />
            </Grid>

            <!-- logging mode -->
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Logging" Style="{StaticResource Label}" />
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Border x:Name="LoggingPill"
                            HorizontalAlignment="Right"
                            CornerRadius="9"
                            BorderThickness="1"
                            BorderBrush="{StaticResource Line}"
                            Padding="8,1,8,2">
                        <TextBlock x:Name="LoggingLabel" FontSize="11.5"
                                   Foreground="{StaticResource Muted}" />
                    </Border>
                    <TextBlock x:Name="SensitiveLine"
                               Visibility="Collapsed"
                               Margin="0,4,0,0"
                               MaxWidth="230"
                               Style="{StaticResource Value}"
                               FontSize="11"
                               Foreground="{StaticResource Muted}" />
                </StackPanel>
            </Grid>

            <!-- session -->
            <Grid x:Name="SessionRow" Style="{StaticResource Row}" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Session" Style="{StaticResource Label}" />
                <TextBlock x:Name="SessionLine" Grid.Column="1" Style="{StaticResource Value}"
                           FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource Muted}" />
            </Grid>

            <!-- a refusal or transport failure from the last action -->
            <Border x:Name="NoticeBox"
                    Visibility="Collapsed"
                    Margin="14,4,14,10"
                    Padding="10,7,10,7"
                    CornerRadius="4"
                    BorderBrush="{StaticResource Accent}"
                    BorderThickness="1">
                <TextBlock x:Name="NoticeText" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{StaticResource Accent}" />
            </Border>

            <Border Height="1" Background="{StaticResource Line}" />

            <WrapPanel Margin="14,12,8,6">
                <Button x:Name="LaunchButton" Content="Open research browser" Style="{StaticResource PrimaryButton}" />
                <Button x:Name="StartButton" Content="Start session" Style="{StaticResource PrimaryButton}" />
                <Button x:Name="RetryButton" Content="Retry now" Style="{StaticResource PrimaryButton}" />
                <Button x:Name="ActivateButton" Content="Start suppression" Style="{StaticResource PrimaryButton}" />
                <Button x:Name="RequestButton" Content="Request a sensitive session"
                        Style="{StaticResource PanelButton}" />
                <Button x:Name="WithdrawButton" Content="Withdraw request" Style="{StaticResource PanelButton}" />
                <Button x:Name="EndButton" Content="End session" Style="{StaticResource WarnButton}" />
            </WrapPanel>

            <Border Height="1" Background="{StaticResource Line}" />

            <TextBlock Margin="14,8,14,10"
                       FontSize="10.5"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}"
                       Text="Only the Mina research browser uses this path. Ordinary Edge and the rest of this PC are unchanged." />
        </StackPanel>
    </Border>
</Window>
