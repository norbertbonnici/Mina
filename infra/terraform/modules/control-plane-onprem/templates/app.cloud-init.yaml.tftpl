#cloud-config
# Mina control plane — application host (API + management portal), ADR-0006.
#
# The application binds two listeners: the node-facing one, which the proxy publishes, and the
# corporate one carrying the portal, the audit read API and everything administrative. The firewall
# below is the second half of that separation. The application enforces it in process by the port a
# connection was accepted on; this enforces it at the network, so neither is a single point of
# failure for the property that the management surface is not on the internet.

package_update: true
packages:
  - nftables
  - ca-certificates
  - qemu-guest-agent

users:
  - default
  - name: mina-admin
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
%{ for key in ssh_keys ~}
      - ${key}
%{ endfor ~}
  # Service account for the control plane. Deliberately no shell and no sudo.
  - name: mina
    system: true
    shell: /usr/sbin/nologin
    lock_passwd: true

write_files:
  - path: /etc/nftables.conf
    permissions: "0644"
    content: |
      #!/usr/sbin/nft -f
      flush ruleset
      table inet filter {
        chain input {
          type filter hook input priority 0; policy drop;
          ct state established,related accept
          iif lo accept
          # The node-facing listener: only the publishing proxy may reach it. Nothing else in the
          # DMZ, and nothing on the internet directly.
          ip saddr ${proxy_ip} tcp dport ${node_port} accept
          # The management listener and administration: corporate ranges only. An egress node that
          # is fully compromised cannot reach these even if it reaches this host's address.
%{ for cidr in corp_cidrs ~}
          ip saddr ${cidr} tcp dport { ${management_port}, 22 } accept
%{ endfor ~}
        }
        chain forward { type filter hook forward priority 0; policy drop; }
      }

  - path: /etc/mina/appsettings.Production.json.example
    permissions: "0640"
    owner: "root:root"
    content: |
      {
        "ConnectionStrings": {
          "MinaDb": "Server=<sql-host>;Database=Mina;Authentication=Active Directory Default;Encrypt=True"
        },
        "Mina": {
          "Hosting": {
            "Listeners": { "NodePort": ${node_port}, "ManagementPort": ${management_port} },
            "DataProtectionKeyPath": "/var/lib/mina/dataprotection-keys",
            "ForwardedProxyCount": 1
          }
        }
      }

runcmd:
  # The Data Protection key ring. Without a persisted path the keys are regenerated on restart and
  # every approver's antiforgery token and sign-in cookie stops validating -- silently, and only
  # after a restart, which is the worst way to find out.
  - [ install, -d, -m, "0700", -o, mina, -g, mina, /var/lib/mina/dataprotection-keys ]
  - [ install, -d, -m, "0750", -o, mina, -g, mina, /var/lib/mina ]
  - [ install, -d, -m, "0750", -o, root, -g, root, /etc/mina ]
  - [ systemctl, enable, --now, nftables ]
  - [ systemctl, enable, --now, qemu-guest-agent ]

# The application itself is deployed here separately -- provisioning creates the host, the account,
# the firewall and the key-ring directory, not the build. Arc onboarding (M4-18) also lands here, and
# is what lets the app reach SQL, Key Vault and the audit container with no stored credential.
