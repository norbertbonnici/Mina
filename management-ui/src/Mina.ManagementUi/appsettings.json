{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "REPLACE_WITH_TENANT_ID",
    "ClientId": "REPLACE_WITH_UI_CLIENT_ID",
    "CallbackPath": "/signin-oidc"
  },
  "Mina": {
    "Ui": {
      "AdminRole": "Mina.Admin"
    },
    "Regions": {
      "Approved": [ "westeurope", "northeurope", "germanywestcentral", "francecentral" ],
      "Active": [ "westeurope" ]
    },
    "SensitiveSession": {
      "ApproverRole": "Mina.Approver",
      "AnalystRole": "Mina.Analyst",
      "MaxDuration": "04:00:00"
    }
  }
}
