# Builds the real egress-node sidecar from source. No shortcuts: this is the same project the node
# runs, published like any other .NET service — not a mock or a stand-in.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish egress-node/src/Mina.EgressNode.Sidecar/Mina.EgressNode.Sidecar.csproj \
    -c Release -o /out --no-self-contained

FROM mcr.microsoft.com/dotnet/aspnet:10.0
# curl only for the container healthcheck, which has to speak to the admission socket the same way
# Envoy does (there is deliberately no TCP listener to probe instead).
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out .
# 0: the admission socket must be reachable by the envoy container, which is a different image with
# no coordinated UID/GID. Production instead runs both processes under real accounts sharing one
# purpose-built group (see egress-node/cloud-init.yaml.tftpl, mina-authz) — deliberately not
# reproduced here, since this stack exists to test the wiring, not to rehearse node hardening.
ENTRYPOINT ["sh", "-c", "umask 000 && exec dotnet Mina.EgressNode.Sidecar.dll"]
