<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Mina.EgressNode.Sidecar-381630d9-d613-4731-a2da-5091efeeabde</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel, for the admission socket only. The sidecar listens on a Unix socket and nothing else. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Envoy's ext_authz speaks gRPC to the sidecar; Type=notify readiness for systemd. -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both: the server the sidecar hosts, and the client the tests call it with. -->
    <Protobuf Include="Protos\envoy_authz.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\integrations\signoz\src\Mina.Observability\Mina.Observability.csproj" />
  </ItemGroup>
</Project>
